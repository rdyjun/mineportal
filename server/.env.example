WEB_PORT=3000

# The "sid" session cookie's Secure flag. Defaults to true; set false for local http dev, since
# browsers silently drop Secure-flagged cookies over a plain http connection.
COOKIE_SECURE=false

# Web trial relay allowlist. Unset uses the four demo-mc ports. An empty value denies every
# trial connection. The desktop app is not limited by this list.
# MINEPORTAL_TRIAL_SERVERS=demo-mc:25565,demo-mc:25566,demo-mc:25567,demo-mc:25568

# Azure app registration (Entra ID) for "Sign in with Microsoft" — see README for setup steps.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:3000/api/account/callback

# Comma-separated origins allowed to open the /ws WebSocket connection. Defaults to local dev's
# own origin (http://localhost:3000) when unset; production must set this to its real domain(s),
# e.g. https://mineportal.kr,https://www.mineportal.kr
WS_ALLOWED_ORIGINS=http://localhost:3000

# Compose sets MINEPORTAL_INTERNAL_HOSTS=demo-mc so the relay can resolve the demo-mc
# DNS name on the internal network. You do not need to put the value in this file;
# the compose service environment overrides it.
# MINEPORTAL_INTERNAL_HOSTS=demo-mc
